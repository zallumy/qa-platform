# ============================================================
# Print QA Check Application — environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ============================================================

# ------------------------------------------------------------
# Postgres
# ------------------------------------------------------------
POSTGRES_USER=qa_platform
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=qa_platform
POSTGRES_PORT=5432

# Full SQLAlchemy connection string used by the API and the Celery worker.
# Inside docker-compose this points at the `postgres` service; if you run
# the backend outside of compose, point it at localhost instead.
DATABASE_URL=postgresql+psycopg2://qa_platform:change_me_locally@postgres:5432/qa_platform

# ------------------------------------------------------------
# Redis (Celery broker + result backend)
# ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------
# Object storage — MinIO locally, real S3 in prod
# ------------------------------------------------------------
S3_BUCKET=qa-platform-files
# Set S3_ENDPOINT_URL for MinIO / any S3-compatible endpoint.
# Leave unset (remove the line) to use real AWS S3.
S3_ENDPOINT_URL=http://minio:9000
# Browser-reachable endpoint used only for presigned download URLs (e.g. PDF
# report downloads) — the internal Docker hostname above isn't resolvable
# from the user's browser. In prod (real S3) this can be left unset; it
# falls back to S3_ENDPOINT_URL, which is already public.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

# MinIO container's own root credentials (must match S3_ACCESS_KEY_ID /
# S3_SECRET_ACCESS_KEY above when running locally via docker-compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------
# Auth
# ------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_64_char_hex_string

# ------------------------------------------------------------
# API
# ------------------------------------------------------------
API_PORT=8000
# Comma-separated list of origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------
FRONTEND_PORT=3000
# Base URL the browser uses to reach the API (must be reachable from the
# user's browser, not just from inside the Docker network)
NEXT_PUBLIC_API_URL=http://localhost:8000
